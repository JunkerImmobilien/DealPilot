# ────────────────────────────────────────────────
# DealPilot — .gitignore
# ────────────────────────────────────────────────

# Node
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (SECRETS!)
.env
.env.*
!.env.example
!backend/.env.example
backend/.env
backend/.env.local
backend/.env.production

# Backend uploads (gehören in Docker-Volume)
backend/uploads/
backend/src/uploads/

# Backups (.bak-Files aus Deployments)
**/*.bak-*
**/*.broken*
**/*.bak
docker-compose.prod.yml.bak-*

# Frontend Pre-Versions
frontend.bak-*
frontend.v*-broken*

# ZIPs (nutzen jetzt Git)
*.zip
dealpilot-v*.zip

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace
.history/

# Logs
*.log
logs/

# Backup-Verzeichnisse + DB-Dumps
backups/
*.sql.gz

# Test outputs
coverage/
.nyc_output/

# Temp
tmp/
.tmp/

# Docker-Volume-Mounts (lokal, falls jemals als bind mount)
caddy_data/
caddy_config/

# SSL / Certs
letsencrypt/

# DealPilot Migration-SQL-Files dürfen ins Repo
!backend/migrations/
!backend/migrations/*.sql

# DB-Backups (V225 + V246-Prod)
backup_*.sql
*.sql.bak
# Deploy-Artefakte (vNNN-Bundles)
/apply-v*.sh
/patches/
/files/
/README-v*.md
*.bak

# tools/deploy-staging.ps1 stand hier bis 01.09.2026 — ohne Begruendung und
# als EINZIGES Werkzeug unter tools/ (gold-audit.py, baue-mailtexte.js und
# die swf-register-Kette sind alle versioniert). Genau deshalb konnte eine
# kaputte Fassung monatelang ueberleben: kein Diff, keine Historie, keine
# Gegenlesung. Nichts Schuetzenswertes steht drin — die Anmeldung laeuft
# ueber den SSH-Schluessel, und beide Server-IPs stehen ohnehin im
# versionierten CLAUDE.md.
